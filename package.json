{
  "name": "pilla",
  "private": true,
  "description": "Gestão de empréstimos (estudo de arquitetura). Ver docs/README.md.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "mutation": "turbo run mutation",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:env": "node scripts/check-env-example.mjs",
    "check:deps": "node scripts/check-allowed-deps.mjs",
    "check:schemas": "node scripts/check-schemas.mjs packages/schemas/src && node scripts/check-avoid.mjs docs/memoria/libs/zod.md packages/schemas/src",
    "test:scripts": "node --test scripts/check-schemas.test.mjs",
    "verify": "pnpm check:deps && pnpm check:env && pnpm check:schemas && pnpm test:scripts && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test && pnpm test:harness",
    "prepare": "lefthook install",
    "test:harness": "python3 -m unittest discover -s tools/alice-harness/tests -t tools/alice-harness"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
