{
  "name": "@pilla/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API e módulos de domínio (RFC-003 §4.1); banco conforme a RFC-005",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "mutation": "stryker run",
    "db:generate": "drizzle-kit generate --config drizzle-kit/core.config.ts",
    "db:regen": "node scripts/db-regen.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@pilla/schemas": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@fast-check/vitest": "0.5.0",
    "@nestjs/testing": "^12.5.1",
    "@pilla/config": "workspace:*",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "~26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
