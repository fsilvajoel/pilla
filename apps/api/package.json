{
  "name": "@pilla/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API e módulos de domínio (RFC-003 §4.1); banco conforme a RFC-005",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "mutation": "stryker run",
    "db:generate": "drizzle-kit generate --config drizzle-kit/core.config.ts",
    "db:regen": "node scripts/db-regen.mjs",
    "db:migrate": "node --env-file=../../.env --import tsx scripts/migrate.mts",
    "db:seed": "node --env-file=../../.env --import tsx scripts/seed.mts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@pilla/config": "workspace:*",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "~26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
