{
  "name": "@pilla/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API e módulos de domínio (RFC-003 §4.1); banco conforme a RFC-005",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
