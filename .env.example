# Variáveis de ambiente do pilla. Copie para .env (chmod 600) e preencha. Uma linha de comentário por variável.

# Ambiente de execução: development | test | production
APP_ENV=development
# Chave da API de busca do Brave (usada pelas ferramentas de pesquisa dos agentes); peça em https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=coloque-sua-chave-aqui
# Chave da API do OpenRouter (modelos remotos para os agentes); peça em https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=coloque-sua-chave-aqui
OPEN_ROUTER_API_KEY2=coloque-sua-chave-aqui
# Marca execução em CI (definida pelo próprio CI); vazio em desenvolvimento. O Playwright só reaproveita servidor já de pé fora do CI
CI=
