# Variáveis de ambiente do pilla. Copie para .env (chmod 600) e preencha. Uma linha de comentário por variável.

# Ambiente de execução: development | test | production
APP_ENV=development
# Chave da API de busca do Brave (usada pelas ferramentas de pesquisa dos agentes); peça em https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=coloque-sua-chave-aqui
# Chave da API do OpenRouter (modelos remotos para os agentes); peça em https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=coloque-sua-chave-aqui
OPEN_ROUTER_API_KEY2=coloque-sua-chave-aqui
# Terceira chave do OpenRouter (usada pelo Baidu no harness); mesma origem da chave anterior
OPEN_ROUTER_API_KEY3=coloque-sua-chave-aqui
# Endereço da API NestJS que o servidor do Next chama (só servidor; o navegador não acessa a API direto)
PILLA_API_URL=http://127.0.0.1:3001
# Porta em que a API escuta; só em 127.0.0.1
PILLA_API_PORT=3001
# Usuário do PostgreSQL de desenvolvimento (infra/docker-compose.yml)
POSTGRES_USER=pilla
# Senha do PostgreSQL de desenvolvimento; troque por uma senha sua no .env
POSTGRES_PASSWORD=troque-a-senha
# Nome do banco de desenvolvimento
POSTGRES_DB=pilla
# Porta publicada em 127.0.0.1 pelo compose; aceita de 1024 a 65535
POSTGRES_PORT=5432
# URL de conexão usada pelos scripts de migrate e seed; o host precisa ser 127.0.0.1 ou localhost
DATABASE_URL=postgres://pilla:troque-a-senha@127.0.0.1:5432/pilla
# Pasta de build do Next (.next por padrão; use outra só se precisar separar o build de dev)
NEXT_DIST_DIR=.next
# Marca execução em CI (definida pelo próprio CI); vazio em desenvolvimento. O Playwright só reaproveita servidor já de pé fora do CI
CI=
# URL base da API, lida só pelo servidor do app web (ADR-0013); ex.: http://localhost:3001
PILLA_API_URL=http://localhost:3001
# Usuário do PostgreSQL de desenvolvimento (infra/docker-compose.yml)
POSTGRES_USER=pilla
# Senha do PostgreSQL de desenvolvimento; valor fictício, só para dev local
POSTGRES_PASSWORD=troque-esta-senha-de-dev
# Nome do banco de desenvolvimento
POSTGRES_DB=pilla
# Porta publicada em 127.0.0.1; inteiro de 1024 a 65535
POSTGRES_PORT=5432
# URL de conexão da API e dos scripts db:migrate e db:seed; o host do seed só pode ser 127.0.0.1 ou localhost
DATABASE_URL=postgres://pilla:troque-esta-senha-de-dev@127.0.0.1:5432/pilla
# Porta da API NestJS em 127.0.0.1; inteiro de 1024 a 65535
PILLA_API_PORT=3001
# Cookies de sessão com atributo Secure; "false" só para teste manual em http na LAN (padrão true)
PILLA_COOKIE_SECURE=true
