# Variáveis do ambiente de trabalho da Alice. Copie para .env (chmod 600) e preencha.
# Este arquivo vai para o git: só nomes e exemplos, NUNCA valores reais.

# Endereço do Ollama onde a Alice roda (máquina com GPU)
OLLAMA_URL=http://ollama-host:11434
# Nome do modelo no Ollama
OLLAMA_MODEL=alice
# Chave da API de busca do Brave (https://api.search.brave.com) — usada só pelo script, nunca enviada ao modelo
BRAVE_SEARCH_API_KEY=troque-pela-sua-chave
# Perfil opcional: sem override, o padrão vem de models.yaml:default. Ver docs/estudo/bancada-modelos.md
# ALICE_PROFILE=qwen35
# Chave da Bia (OpenRouter); configure no ambiente ou no .env local, sem colocar credenciais no git
# OPEN_ROUTER_API_KEY=
